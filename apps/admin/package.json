{
  "name": "@espejo/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch src/server/index.ts --dev\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test src/server/custody.test.ts src/server/sigi-map.test.ts src/server/iure-map.test.ts src/server/directorio.test.ts src/server/adb.test.ts src/server/informe.test.ts src/server/dni-foto.test.ts src/server/acta.test.ts src/server/consentimiento.test.ts"
  },
  "dependencies": {
    "@espejo/shared": "*",
    "@types/pdfkit": "^0.17.6",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "docx": "^9.13.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
